# Template only -- never commit a real filled-in copy of this file.
# Create the real Secret with kubectl instead of applying literal values
# checked into git:
#
#   kubectl create secret generic shadow-runner-secrets \
#     --from-literal=SHADOW_RUNNER_API_KEYS="prodkey:admin" \
#     --from-literal=DATABASE_URL="postgresql://user:pass@host:5432/shadowrunner" \
#     --from-literal=SHADOW_RUNNER_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..." \
#     --from-literal=ANTHROPIC_API_KEY="sk-ant-..."
#
# Or, better in most real deployments: don't put secret material in K8s
# Secrets at all (they're only base64-encoded, not encrypted, unless you've
# enabled encryption-at-rest and RBAC restrictions on Secret objects) --
# use External Secrets Operator, Vault's Kubernetes auth + CSI driver, or
# your cloud provider's secrets manager (AWS Secrets Manager, GCP Secret
# Manager, Azure Key Vault) to inject these instead. See
# SHADOW_RUNNER.md's "Secrets Management" section.
#
# Any of those tools that mount secrets as FILES (Vault Agent injector,
# the Vault CSI driver, etc.) rather than env vars work here too, with no
# code changes: every one of these config values also honors a "_FILE"
# suffix pointing at a file path -- e.g. set
# SHADOW_RUNNER_API_KEYS_FILE=/vault/secrets/api-keys instead of
# SHADOW_RUNNER_API_KEYS directly. See secrets_helper.py. Verified working
# both in a plain Docker container (a file bind-mounted in) and this
# would work identically with a CSI-mounted volume in a real cluster.
apiVersion: v1
kind: Secret
metadata:
  name: shadow-runner-secrets
type: Opaque
stringData:
  SHADOW_RUNNER_API_KEYS: "REPLACE_ME:admin"
  DATABASE_URL: "postgresql://user:REPLACE_ME@host:5432/shadowrunner"
  SHADOW_RUNNER_ALERT_WEBHOOK_URL: ""
