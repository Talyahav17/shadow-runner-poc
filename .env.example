# Copy this file to .env and set real values to pin fixed API keys
# across container restarts. Left unset, docker-compose passes an empty
# string through and the service falls back to generating a random
# admin-role key at startup (logged once) -- see SHADOW_RUNNER.md.

# Simple option: one key, full (admin) access. Backward-compatible with
# every earlier version of this service.
SHADOW_RUNNER_API_KEY=

# RBAC option: multiple keys, each scoped to a role (viewer / operator /
# admin -- see auth.py). If set, this takes priority over the single key
# above. Example:
# SHADOW_RUNNER_API_KEYS=change-me-admin:admin,change-me-operator:operator,change-me-viewer:viewer
SHADOW_RUNNER_API_KEYS=

# Optional: a Slack incoming-webhook URL (or any endpoint accepting the
# same {"text": "..."} JSON body) to page on shadow mismatches/errors,
# instead of only writing a CRITICAL log line. Left unset, alerting is a
# no-op -- see alerting.py.
SHADOW_RUNNER_ALERT_WEBHOOK_URL=
